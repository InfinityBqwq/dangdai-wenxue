    { "year": 1983, "match": ["精神污染"], "title": "清除精神污染运动", "type": "event", "blurb": "人道主义与异化问题讨论、现代派文学遭批判，'三个崛起'被点名，文学界再度收紧。" },
    { "year": 1984, "month": 12, "matchAny": ["杭州", "寻根"], "title": "杭州会议与'寻根'兴起", "type": "event", "blurb": "杭州研讨会讨论'文化'与文学，韩少功《文学的根》发表，寻根文学正式登场。" },
