    { "year": 1962, "month": 8, "match": ["大连"], "title": "大连会议", "type": "event", "blurb": "邵荃麟提出'写中间人物'，两年后遭批判，成为'黑八论'之一。" },
    { "year": 1963, "match": ["大写十三年"], "title": "'大写十三年'口号", "type": "policy", "blurb": "柯庆施提出只写1949年后的十三年，文艺题材空间急剧收窄。" },
    { "year": 1964, "matchAny": ["京剧革命", "现代戏"], "title": "京剧革命", "type": "event", "blurb": "全国京剧现代戏观摩演出大会举行，江青介入文艺界，样板戏工程启动。" },
    { "year": 1966, "month": 2, "match": ["部队文艺工作座谈会"], "title": "《部队文艺工作座谈会纪要》", "type": "policy", "blurb": "提出'文艺黑线专政论'，全盘否定十七年文艺，文革文艺纲领确立。" },
    { "year": 1966, "month": 6, "matchAny": ["文化大革命", "横扫"], "title": "文革爆发，文学刊物停刊", "type": "event", "blurb": "报刊停刊、作家下放，公开文学仅剩样板戏与浩然等极少数作品。" },
    { "year": 1967, "month": 5, "match": ["样板戏"], "title": "八大样板戏定型", "type": "work", "blurb": "《红灯记》《沙家浜》《智取威虎山》等八部样板戏在汇演中定型，'三突出'原则统治创作。" },
    { "year": 1976, "month": 4, "match": ["天安门"], "title": "天安门诗歌运动", "type": "event", "blurb": "四五运动中的诗词大爆发，是文革地下文学转向公开抗议的标志，被视为新时期诗歌的序幕。" },
    { "year": 1976, "month": 10, "match": ["粉碎"], "title": "粉碎'四人帮'", "type": "event", "blurb": "文革十年结束，文艺界开始'拨乱反正'，文学史翻页。" },
    { "year": 1977, "month": 11, "match": ["班主任"], "title": "刘心武《班主任》发表", "type": "work", "blurb": "发表于《人民文学》，'伤痕文学'的发端，喊出'救救被'四人帮'坑害了的孩子'。" },
    { "year": 1978, "month": 8, "match": ["伤痕"], "title": "卢新华《伤痕》发表", "type": "work", "blurb": "《文汇报》发表复旦大学学生作品，'伤痕文学'由此定名。" },
    { "year": 1978, "month": 12, "match": ["三中全会"], "title": "十一届三中全会", "type": "event", "blurb": "'实践是检验真理的唯一标准'大讨论与三中全会确立改革开放，思想解放为文学解冻奠基。" },
    { "year": 1979, "month": 10, "match": ["第四次"], "title": "第四次文代会", "type": "event", "blurb": "邓小平祝词提出'写什么和怎么写，只能由文艺家在艺术实践中去探索'，'文艺民主'成为关键词。" },
    { "year": 1980, "matchAny": ["为人民服务", "二为"], "title": "'二为'方向提出", "type": "policy", "blurb": "'文艺为人民服务、为社会主义服务'取代'为政治服务'，当代文学的总体方向被重新定义。" },
