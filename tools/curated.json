    { "year": 1956, "month": 4, "match": ["百花齐放", "百家争鸣"], "title": "双百方针提出", "type": "policy", "blurb": "毛泽东正式提出'百花齐放、百家争鸣'，短暂开启'百花时代'的文学革新与理论争鸣。" },
    { "year": 1957, "month": 1, "match": ["茶馆"], "title": "老舍《茶馆》发表", "type": "work", "blurb": "发表于《收获》创刊号，以'图卷戏'侧面透露法写三个时代，话剧民族化的典范。" },
